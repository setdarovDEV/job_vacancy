# Production environment for nginx/docker-compose.prod.yml.
# Copy to .env and fill all secrets before running docker compose.

# General
APP_NAME=Job Vacancy
WEB_URL=https://jobvacancy.uz
HTTP_CORS_ORIGINS=https://jobvacancy.uz

# Postgres
POSTGRES_USER=jobvacancy
POSTGRES_PASSWORD=CHANGE_ME_32CHARS_MIN
POSTGRES_DB=jobvacancy

# Auth
JWT_SECRET=CHANGE_ME_64CHARS_MINIMUM_REQUIRED_FOR_PRODUCTION
JWT_ISSUER=jobvacancy.uz
AUTH_COOKIE_DOMAIN=jobvacancy.uz

# Google OAuth client IDs (web, android, ios). Comma-separated.
GOOGLE_CLIENT_IDS=

# SMTP (production: starttls or tls)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@jobvacancy.uz
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=Job Vacancy <no-reply@jobvacancy.uz>
SMTP_TLS=starttls

# Telegram
TELEGRAM_GATEWAY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=jobvacancy_uz_bot
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_RANDOM_STRING

# S3 / MinIO
S3_ACCESS_KEY=jobvacancy
S3_SECRET_KEY=CHANGE_ME_16CHARS_MIN
S3_REGION=us-east-1
S3_PUBLIC_ENDPOINT=jobvacancy.uz
S3_PUBLIC_USE_SSL=true
S3_PUBLIC_BUCKET=jv-public
S3_PRIVATE_BUCKET=jv-private
S3_PUBLIC_BASE_URL=https://jobvacancy.uz/jv-public

# Monitoring
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Backups (any S3-compatible store)
BACKUP_S3_BUCKET=jobvacancy-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_ENDPOINT=https://s3.example.com
BACKUP_S3_REGION=us-east-1

# AI (Anthropic)
ANTHROPIC_API_KEY=
AI_MODEL=claude-3-5-sonnet-20241022
AI_MAX_TOKENS=1024

# Logging
LOG_LEVEL=info
