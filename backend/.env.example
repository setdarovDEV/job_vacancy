# Copy to .env for local development:  cp .env.example .env
APP_ENV=development
WEB_URL=http://localhost:5180

HTTP_ADDR=:8090
HTTP_CORS_ORIGINS=http://localhost:5180
METRICS_ADDR=127.0.0.1:9091

# Infrastructure from nginx/docker-compose.dev.yml
DATABASE_URL=postgres://jobvacancy:jobvacancy@localhost:5440/jobvacancy?sslmode=disable
REDIS_URL=redis://localhost:6390/0

# Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
AUTH_COOKIE_SECURE=false

# Comma-separated OAuth client IDs (web, android, ios) from Google Cloud Console.
GOOGLE_CLIENT_IDS=

# Mailpit catches all mail locally: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
SMTP_FROM=Job Vacancy <no-reply@jobvacancy.uz>

# https://gateway.telegram.org — leave empty in dev to print codes to the log.
TELEGRAM_GATEWAY_TOKEN=

LOG_LEVEL=debug
LOG_FORMAT=text

# Object storage (MinIO from nginx/docker-compose.dev.yml)
S3_ENDPOINT=localhost:9200
S3_PUBLIC_ENDPOINT=localhost:9200
S3_ACCESS_KEY=jobvacancy
S3_SECRET_KEY=jobvacancy-secret
S3_PUBLIC_BASE_URL=http://localhost:9200/jv-public

# Notification bot from @BotFather (empty in dev: messages are logged).
# After deploy: ./ctl telegram-webhook https://jobvacancy.uz/api/v1/telegram/webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=jobvacancy_uz_bot
TELEGRAM_WEBHOOK_SECRET=dev-webhook-secret
