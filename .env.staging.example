# staging.jobvacancy.uz settings (TZ OPS-08): production stack + nginx/docker-compose.staging.yml.
# Copy to .env.staging on the staging server, fill in every "change-me", chmod 600.
#   cp .env.staging.example .env.staging && chmod 600 .env.staging
#   make prod-config          # validates every compose file with the example env files
#
# Values with $ or spaces go in single quotes ('...'): compose reads them literally then.
# Generate secrets with the command next to them. docs/RUNBOOK.md explains every step.

# ---- deployment ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=jobvacancy-staging
# db: Postgres on this host. backup: daily wal-g backups (next to Postgres). On a split
# setup (TZ topology: app-1 + db-1) use COMPOSE_PROFILES= on app-1 and db,backup on db-1.
COMPOSE_PROFILES=db          # no own backups: data comes from production (make staging-refresh)
DOMAIN=staging.jobvacancy.uz
APP_ENV=staging
# Images built by CI (.github/workflows/deploy.yml). IMAGE_TAG is set by `make deploy TAG=...`.
IMAGE_PREFIX=ghcr.io/setdarovdev/jobvacancy
IMAGE_TAG=latest
# Private networks; change only if they collide with the host's own networks.
FRONT_SUBNET=10.250.10.0/24
BACK_SUBNET=10.250.20.0/24

# ---- TLS (Let's Encrypt, `make cert`) -------------------------------------------------------
LETSENCRYPT_EMAIL=ops@jobvacancy.uz
# With Cloudflare in front, DNS-01 is the robust choice: an API token with Zone:DNS:Edit for
# jobvacancy.uz. Leave empty to use HTTP-01 through port 80 instead.
CLOUDFLARE_API_TOKEN=

# ---- database -------------------------------------------------------------------------------
DB_NAME=jobvacancy
DB_HOST=postgres            # db-1's private IP on a split setup
DB_PORT=5432
DB_SSLMODE=disable          # "require" when DB_HOST is another machine without a private network
DB_PUBLISH=127.0.0.1:5432   # db-1: its private IP, e.g. 10.0.0.3:5432 (firewalled to app-1)
APP_DB_USER=jobvacancy
APP_DB_PASSWORD=change-me   # openssl rand -hex 24  (hex: safe inside the connection URL)
POSTGRES_SUPERUSER_PASSWORD=change-me   # openssl rand -hex 24
MONITORING_DB_PASSWORD=change-me   # openssl rand -hex 24; exporters (role "monitoring", read-only)
# OPS-03 sizing for a dedicated 8 GB db-1. Single 8 GB server running everything: 1GB / 3GB / 2.5G.
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_MEMORY=1536M
PG_CPUS=1.5

# ---- backups: wal-g → offsite S3 (TZ OPS-03) ------------------------------------------------
# A different provider/region than the servers (Backblaze B2, Cloudflare R2, Hetzner, AWS...).
BACKUP_ENABLED=false
BACKUP_S3_PREFIX=s3://jobvacancy-backups/pg
BACKUP_S3_ENDPOINT=         # empty for AWS; e.g. https://s3.eu-central-003.backblazeb2.com
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=change-me
BACKUP_S3_SECRET_KEY=change-me
# Client-side encryption (libsodium). KEEP A COPY OFFLINE: without it backups are useless.
BACKUP_ENCRYPTION_KEY=change-me   # openssl rand -hex 32
BACKUP_RETAIN_FULL=14       # daily full backups kept (= 14 days of point-in-time recovery)
BACKUP_HOUR_UTC=21          # 02:00 Tashkent
# Dead man's switch (healthchecks.io or similar): pinged after every backup, /fail on error.
BACKUP_HEARTBEAT_URL=

# Read-only access to PRODUCTION's backups for make staging-refresh (the monthly drill).
RESTORE_S3_PREFIX=s3://jobvacancy-backups/pg
RESTORE_S3_ENDPOINT=
RESTORE_S3_REGION=us-east-1
RESTORE_S3_ACCESS_KEY=change-me     # a read-only key for the backup bucket
RESTORE_S3_SECRET_KEY=change-me
RESTORE_ENCRYPTION_KEY=change-me    # production's BACKUP_ENCRYPTION_KEY

# ---- redis (two instances: cache = allkeys-lru, state = noeviction + AOF) --------------------
REDIS_PASSWORD=change-me    # openssl rand -hex 24
REDIS_CACHE_MAXMEMORY=128mb
REDIS_STATE_MAXMEMORY=128mb

# ---- object storage (MinIO) ------------------------------------------------------------------
MINIO_ROOT_USER=change-me           # openssl rand -hex 8
MINIO_ROOT_PASSWORD=change-me       # openssl rand -hex 24
# The API's own user, created by minio-init with access to jv-public/jv-private only.
S3_ACCESS_KEY=change-me             # openssl rand -hex 10
S3_SECRET_KEY=change-me             # openssl rand -hex 24

# ---- auth -------------------------------------------------------------------------------------
JWT_SECRET=change-me        # openssl rand -base64 48
JWT_KID=k1
# Rotation: move the current pair here, set a new JWT_SECRET/JWT_KID, deploy, and clear
# these after ACCESS_TOKEN_TTL (15m).
JWT_PREVIOUS_SECRET=
JWT_PREVIOUS_KID=
AUTH_COOKIE_DOMAIN=
# Google Cloud Console OAuth client IDs (web, android, ios), comma-separated. The web one is
# also compiled into the web image as VITE_GOOGLE_CLIENT_ID (CI variable).
GOOGLE_CLIENT_IDS=
VITE_GOOGLE_CLIENT_ID=

# ---- e-mail (SPF, DKIM and DMARC for jobvacancy.uz must be in place, TZ section 13) -----------
SMTP_HOST=mailpit           # every staging e-mail is caught (docker-compose.staging.yml)
SMTP_PORT=1025
SMTP_TLS=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM='Job Vacancy <no-reply@jobvacancy.uz>'

# ---- telegram -----------------------------------------------------------------------------------
TELEGRAM_GATEWAY_TOKEN=             # empty on staging: codes go to the api log
TELEGRAM_BOT_TOKEN=                 # @BotFather; then: make ctl ARGS="telegram-webhook https://jobvacancy.uz/api/v1/telegram/webhook"
TELEGRAM_BOT_USERNAME=jobvacancy_uz_bot
TELEGRAM_WEBHOOK_SECRET=change-me   # openssl rand -hex 32

# ---- monitoring and error tracking (TZ OPS-04/05, make monitoring-up) --------------------------
# postgres_exporter / sql_exporter log in as the read-only role "monitoring" (column grants in
# nginx/postgres/monitoring.sql, applied by every deploy).
# MONITORING_DB_PASSWORD is set in the database section above.
GRAFANA_ADMIN_PASSWORD=change-me    # openssl rand -hex 16; UI over ssh -L 3000:127.0.0.1:3000
# Alerts → Telegram: a bot from @BotFather added to the on-call group; the group's chat id
# (negative, e.g. -1001234567890: send a message there, then open
# https://api.telegram.org/bot<token>/getUpdates). ALERT_TELEGRAM_THREAD_ID: a forum topic.
ALERT_TELEGRAM_BOT_TOKEN=            # staging: optional (a separate test chat)
ALERT_TELEGRAM_CHAT_ID=
ALERT_TELEGRAM_THREAD_ID=
# Dead man's switch for the monitoring itself (healthchecks.io check, period 1 min, grace
# 5 min): Alertmanager pings it every minute; when the pings stop you get alerted from outside.
ALERT_WATCHDOG_URL=
# Split setup (app-1 + db-1): db-1's node_exporter, e.g. 10.0.0.3:9100 (comma-separated).
NODE_EXPORTER_EXTRA_TARGETS=
# GlitchTip (Sentry protocol). After `make monitoring-up`: make glitchtip-admin, log in on
# http://localhost:8000 (SSH tunnel), create the organisation and two projects (go, web).
GLITCHTIP_SECRET_KEY=change-me      # openssl rand -hex 32
GLITCHTIP_DB_PASSWORD=change-me     # openssl rand -hex 24
GLITCHTIP_DOMAIN=http://localhost:8000
GLITCHTIP_FROM_EMAIL=errors@jobvacancy.uz
GLITCHTIP_EMAIL_URL=consolemail://  # smtp://user:password@smtp.example.com:587 for e-mail alerts
# The DSNs GlitchTip shows for each project, with the host replaced:
#   Go (api, worker): http://<key>@glitchtip:8000/<id>          (private network)
#   web (browser):    https://<key>@staging.jobvacancy.uz/errors/<id>   (nginx /errors/, same origin)
SENTRY_DSN=
VITE_SENTRY_DSN=

# ---- workers and logs ---------------------------------------------------------------------------
WORKER_CRITICAL_WORKERS=4
WORKER_DEFAULT_WORKERS=6
LOG_LEVEL=info

# ---- staging access --------------------------------------------------------------------------------
# htpasswd lines for HTTP basic auth in front of staging, e.g. from:
#   docker run --rm httpd:2.4-alpine htpasswd -nbB team 'password'
STAGING_BASIC_AUTH=
